<Window x:Class="ProjectSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectSync"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="480"
        Background="#FFF5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="ProjectSync" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="#FF465568"
                       Text="VRChat / Unity共同制作の安全な作業フロントエンド" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,18"
                Padding="16"
                Background="White"
                BorderBrush="#FFD7DEE8"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="ワークスペース" />
                <TextBlock Margin="0,6,0,0" Text="{Binding ProjectPathDisplay}" TextWrapping="Wrap" />
                <Button Content="Unityプロジェクトを選択"
                        Click="SelectProject_Click"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0" />
                <TextBlock Margin="0,8,0,0"
                           FontWeight="SemiBold"
                           Foreground="{Binding StatusBrush}"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="2">
            <Button Content="新しい作業"
                    IsEnabled="{Binding CanStartTask}"
                    ToolTip="GitHub設定とProjectSync Service接続後に利用できます。" />
            <Button Content="作業を再開"
                    IsEnabled="{Binding CanResumeTask}"
                    ToolTip="共有Task取得後に利用できます。" />
            <Button Content="作業を保存"
                    IsEnabled="{Binding CanSaveTask}"
                    ToolTip="有効なSessionとLFS Lockの一致が必要です。" />
            <Button Content="変更を提出"
                    IsEnabled="{Binding CanSubmitTask}"
                    ToolTip="remote到達確認済みSnapshotが必要です。" />
            <Button Content="状態を再確認" Command="{Binding RefreshCommand}" />
        </WrapPanel>

        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="16"
                Background="#FF17202A"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock FontFamily="Consolas"
                           Foreground="#FFE8EEF5"
                           Text="{Binding DiagnosticText}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
